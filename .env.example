# 이 파일을 .env로 복사하고 실제 키를 입력하세요. .env는 커밋하지 않습니다.
PORT=5179
# 로컬에서는 127.0.0.1, Render 환경변수에서는 0.0.0.0을 사용합니다.
HOST=127.0.0.1
TOUR_API_SERVICE_KEY=
# 공공데이터포털 Decoding 키를 권장합니다. 기존 관광정보 API용입니다.
KAKAO_MAP_JS_KEY=
# 카카오 JavaScript 키는 지도·장소 검색을 위해 브라우저에 전달됩니다.
# JavaScript SDK 도메인에 http://127.0.0.1:5179 및 사용하는 localhost 주소를 등록하세요.
YOUTUBE_API_KEY=
# Google Cloud에서 YouTube Data API v3를 활성화한 키입니다. 서버에서만 사용합니다.
# 서버 중계 방식이므로 브라우저 HTTP 리퍼러 제한을 적용한 키는 사용할 수 없습니다.
GOOGLE_CUSTOM_SEARCH_API_KEY=
GOOGLE_CUSTOM_SEARCH_CX=
# 이미지 검색을 켠 Programmable Search Engine의 ID(cx)와 기존 이용 가능한 API 키입니다.
# Google Custom Search JSON API는 신규 이용 제한·2027-01-01 지원 종료 예정입니다.
