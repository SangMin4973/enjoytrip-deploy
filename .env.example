# 실제 API를 사용할 때 이 파일을 .env로 복사하고 값을 입력하세요.
# 샘플 모드는 키 없이 실행됩니다. .env는 커밋하지 않습니다.
PORT=5173
TOUR_API_SERVICE_KEY=
# 공공데이터포털의 Decoding 키를 권장합니다. Encoding 키도 한 번 디코딩합니다.
# 국문 관광정보 서비스_GW 활용 신청이 승인된 키를 정확하게 붙여 넣으세요.
# 오류 30은 등록되지 않은 키, 20은 접근 거부, 22는 요청 한도 초과입니다.
KAKAO_MAP_JS_KEY=
# 카카오 JavaScript 키는 지도 로딩에 필요해 브라우저에 전달됩니다.
# 카카오 앱의 JavaScript 키 설정에서 JavaScript SDK 도메인에
# http://localhost:5173 등록이 필요합니다. 도메인 불일치 시 HTTP 401입니다.
